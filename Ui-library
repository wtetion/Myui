        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        PlaceholderText = properties.Placeholder or "Enter text",
        PlaceholderColor3 = themeColors(app).Muted,
        Text = properties.Value or "",
        TextColor3 = themeColors(app).Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, self._container)
    addCorner(box, 7)
    addStroke(box, themeColors(app).Border, 0.5, 1)
    addPadding(box, 9, 8, 0, 0)
    local control = component("TextField", box, box.Text)
    local updating = false
    app:_connect(box:GetPropertyChangedSignal("Text"), function()
        if updating then return end
        control.Value = box.Text
        callback(properties.TextChanged, control, box.Text)
        callback(properties.ValueChanged, control, box.Text)
    end)
    function control:SetValue(value, fire)
        updating = true
        box.Text = tostring(value or "")
        updating = false
        self.Value = box.Text
        if fire ~= false then
            callback(properties.TextChanged, self, box.Text)
            callback(properties.ValueChanged, self, box.Text)
        end
    end
    function control:GetValue() return box.Text end
    return control
end

function Side:Stepper(properties)
    properties = properties or {}
    local minimum = tonumber(properties.Minimum) or 0
    local maximum = tonumber(properties.Maximum) or 100
    local step = tonumber(properties.Step) or 1
    local value = math.clamp(tonumber(properties.Value) or minimum, minimum, maximum)
    local app = self._row._app
    rowHeight(self._row, math.max(self._row._frame.Size.Y.Offset, 54))
    local group = make("Frame", {
        Name = "Stepper",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(102, 30),
        BackgroundColor3 = themeColors(app).Sidebar,
        BorderSizePixel = 0,
    }, self._container)
    addCorner(group, 7)
    addStroke(group, themeColors(app).Border, 0.5, 1)
    local number = label(group, tostring(value), UDim2.new(1, -54, 1, 0), UDim2.new(0, 6, 0, 0), 11, themeColors(app).Text, {
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    local control = component("Stepper", group, value)
    function control:SetValue(nextValue, fire)
        value = math.clamp(tonumber(nextValue) or minimum, minimum, maximum)
        self.Value = value
        number.Text = tostring(value)
        if fire ~= false then callback(properties.ValueChanged, self, value) end
    end
    function control:GetValue() return value end
    local minus = make("TextButton", { Size = UDim2.fromOffset(25, 28), Position = UDim2.new(1, -52, 0, 1), BackgroundTransparency = 1, Text = "−", TextColor3 = themeColors(app).Text, TextSize = 18, Font = Enum.Font.Gotham, ZIndex = 2 }, group)
    local plus = make("TextButton", { Size = UDim2.fromOffset(25, 28), Position = UDim2.new(1, -26, 0, 1), BackgroundTransparency = 1, Text = "+", TextColor3 = themeColors(app).Text, TextSize = 17, Font = Enum.Font.Gotham, ZIndex = 2 }, group)
    function control:Increment() self:SetValue(value + step, true) end
    function control:Decrement() self:SetValue(value - step, true) end
    bindClick(app, minus, function() control:Decrement() end)
    bindClick(app, plus, function() control:Increment() end)
    return control
end

function Side:KeybindField(properties)
    properties = properties or {}
    local app = self._row._app
    local value = properties.Value or Enum.KeyCode.Unknown
    local listening = false
    rowHeight(self._row, math.max(self._row._frame.Size.Y.Offset, 54))
    local button = make("TextButton", {
        Name = "KeybindField",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(96, 29),
        BackgroundColor3 = themeColors(app).Sidebar,
        BorderSizePixel = 0,
        Text = value == Enum.KeyCode.Unknown and (properties.Placeholder or "Set shortcut") or value.Name,
        TextColor3 = themeColors(app).Text,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        AutoButtonColor = true,
    }, self._container)
    addCorner(button, 7)
    addStroke(button, themeColors(app).Border, 0.5, 1)
    local control = component("KeybindField", button, value)
    function control:SetValue(nextValue, fire)
        if typeof(nextValue) ~= "EnumItem" then return end
        value = nextValue
        self.Value = value
        button.Text = value.Name
        if fire ~= false then callback(properties.ValueChanged, self, value) end
    end
    function control:GetValue() return value end
    bindClick(app, button, function()
        listening = true
        button.Text = "Press a key…"
    end)
    app:_connect(UserInputService.InputBegan, function(input, gameProcessed)
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            listening = false
            control:SetValue(input.KeyCode, true)
            return
        end
        if not listening and input.KeyCode == value and value ~= Enum.KeyCode.Unknown then
            callback(properties.BindPressed, control, value, true, gameProcessed)
        end
    end)
    return control
end

function Side:Symbol(properties)
    properties = properties or {}
    local image = properties.Image
    local instance
    if type(image) == "string" and string.match(image, "^rbxassetid://") then
        instance = make("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(properties.Size or 20, properties.Size or 20),
            Image = image,
            ImageColor3 = properties.ImageColor3 or themeColors(self._row._app).Text,
        }, self._container)
    else
        local symbolText = type(image) == "string" and image or "◈"
        instance = label(self._container, symbolText, UDim2.fromOffset(properties.Size or 20, properties.Size or 20), UDim2.new(),
            properties.TextSize or 15, properties.ImageColor3 or themeColors(self._row._app).Text, {
                TextXAlignment = Enum.TextXAlignment.Center,
            })
    end
    return component("Symbol", instance)
end

function Side:ImageSurface(properties)
    properties = properties or {}
    local tile = make("Frame", {
        Name = "ImageSurface",
        Size = UDim2.fromOffset(properties.Size or 28, properties.Size or 28),
        BackgroundColor3 = properties.SurfaceColor or Color3.fromRGB(230, 231, 235),
        BorderSizePixel = 0,
    }, self._container)
    addCorner(tile, 7)
    local icon = properties.Image or "◈"
    if type(icon) == "string" and string.match(icon, "^rbxassetid://") then
        make("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.15, 0.15), Image = icon, ImageColor3 = properties.ImageColor or Color3.new(1, 1, 1) }, tile)
    else
        label(tile, icon, UDim2.fromScale(1, 1), UDim2.new(), 14, properties.ImageColor or Color3.new(1, 1, 1), { TextXAlignment = Enum.TextXAlignment.Center })
    end
    return component("ImageSurface", tile)
end

function UI.RegisterComponent(name, maker)
    assert(type(name) == "string" and name ~= "", "Component name must be a non-empty string")
    assert(type(maker) == "function", "Component maker must be a function")
    UI._customComponents = UI._customComponents or {}
    UI._customComponents[name] = maker
end

function UI.Component(properties)
    properties = properties or {}
    local parent = properties.Parent
    assert(typeof(parent) == "Instance", "CascadeStyleUI.Component requires Parent")
    local screen = parent:IsA("ScreenGui") and parent or parent:FindFirstAncestorOfClass("ScreenGui")
    local app = setmetatable({
        ScreenGui = screen or parent,
        Theme = type(properties.Theme) == "table" and (properties.Theme._id or "Light") or properties.Theme or "Light",
        AccentColor = properties.Accent or UI.Accents.Blue,
        _connections = {},
        _destroyed = false,
    }, UI)
    if type(app.AccentColor) == "table" then
        app.AccentColor = app.AccentColor.Color or app.AccentColor.Light or UI.Accents.Blue
    end
    local context = {
        Type = "ComponentContext",
        Parent = parent,
        Theme = app.Theme,
        Accent = app.AccentColor,
        _app = app,
    }
    function context:Row(rowProperties)
        return setmetatable({ _app = self._app, _tab = nil, _parent = self.Parent }, Form):Row(rowProperties)
    end

    local exposed = {
        "Toggle", "Button", "Slider", "RadioButtonGroup", "ColorSwatches", "PopUpButton",
        "PullDownButton", "TextField", "Stepper", "KeybindField", "Label", "Symbol", "ImageSurface",
    }
    local contextMeta = {}
    contextMeta.__index = function(self, key)
        if key == "Row" then return rawget(context, "Row") end
        if table.find(exposed, key) then
            return function(_, componentProperties)
                componentProperties = componentProperties or {}
                local target = componentProperties.Parent or self.Parent
                local form = setmetatable({ _app = self._app, _tab = nil, _parent = target }, Form)
                local height = componentProperties.Height or (componentProperties.Preview and 126 or 62)
                local row = form:Row({ Height = height })
                row._left.Size = UDim2.new(0, 0, 1, 0)
                row._right.AnchorPoint = Vector2.new(0, 0)
                row._right.Position = UDim2.new(0, 10, 0, 0)
                row._right.Size = UDim2.new(1, -20, 1, 0)
                local control = Side[key](row:Right(), componentProperties)
                return control, control.__instance
            end
        end
        return nil
    end
    return setmetatable(context, contextMeta)
end

Side.__index = function(self, key)
    local method = rawget(Side, key)
    if method then return method end
    local makers = UI._customComponents
    local maker = makers and makers[key]
    if maker then
        return function(side, properties)
            return maker(side, properties)
        end
    end
    return nil
end

UI.New = UI.new

return UI
