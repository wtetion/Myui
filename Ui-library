local COMPONENT_METATABLE = {}
COMPONENT_METATABLE.__index = function(object, key)
    if key == "ClassName" then return object.__instance.ClassName end
    if key == "IsA" then
        return function(_, className)
            return object.__instance:IsA(className)
        end
    end
    local instance = object.__instance
    local ok, value = pcall(function() return instance[key] end)
    if ok then
        if type(value) == "function" then
            return function(_, ...)
                return value(instance, ...)
            end
        end
        return value
    end
    return nil
end

local function component(typeName, instance, value)
    return setmetatable({
        Type = typeName,
        __instance = instance,
        Value = value,
    }, COMPONENT_METATABLE)
end

local function themeColors(app)
    local dark = app.Theme == "Dark"
    return {
        Window = dark and Color3.fromRGB(31, 32, 36) or COLORS.Window,
        Sidebar = dark and Color3.fromRGB(39, 40, 45) or COLORS.Sidebar,
        Panel = dark and Color3.fromRGB(49, 50, 56) or COLORS.Panel,
        Text = dark and Color3.fromRGB(242, 242, 247) or COLORS.Text,
        Muted = dark and Color3.fromRGB(166, 167, 175) or COLORS.Muted,
        Border = dark and Color3.fromRGB(75, 76, 83) or COLORS.Border,
        Selection = dark and Color3.fromRGB(57, 77, 109) or COLORS.Selection,
    }
end

local function callback(callbackFunction, control, ...)
    if type(callbackFunction) ~= "function" then return end
    local ok, err = pcall(callbackFunction, control, ...)
    if not ok then warn("[CascadeStyleUI] Component callback error: " .. tostring(err)) end
end

