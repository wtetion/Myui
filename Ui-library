--[[
    CascadeStyleUI
    A small, dependency-free Roblox settings UI with a macOS-style sidebar.
    Inspired by the public Cascade component API and the supplied visual
    references; this implementation is original and does not include Cascade
    source code or assets.

    Use from a LocalScript:
        local UI = require(path.To.CascadeStyleUI)
        local app = UI.new({ Title = "My App" })
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = {}
local Section = {}
local Tab = {}
local PageSection = {}
Section.__index = Section
Tab.__index = Tab
PageSection.__index = PageSection
UI.__index = UI

local COLORS = {
    Window = Color3.fromRGB(246, 246, 249),
    Sidebar = Color3.fromRGB(239, 239, 243),
    Panel = Color3.fromRGB(255, 255, 255),
    Text = Color3.fromRGB(34, 34, 39),
    Muted = Color3.fromRGB(111, 112, 121),
    Border = Color3.fromRGB(222, 223, 228),
    Selection = Color3.fromRGB(218, 231, 250),
    Blue = Color3.fromRGB(0, 122, 255),
    Green = Color3.fromRGB(48, 209, 88),
    Red = Color3.fromRGB(255, 95, 87),
    Yellow = Color3.fromRGB(255, 189, 46),
}

local ICON_PALETTE = {
    { Color3.fromRGB(83, 143, 245), Color3.fromRGB(234, 242, 255) },
    { Color3.fromRGB(64, 179, 120), Color3.fromRGB(230, 248, 239) },
    { Color3.fromRGB(255, 149, 0), Color3.fromRGB(255, 240, 219) },
    { Color3.fromRGB(175, 82, 222), Color3.fromRGB(246, 231, 255) },
    { Color3.fromRGB(255, 55, 95), Color3.fromRGB(255, 231, 237) },
    { Color3.fromRGB(50, 173, 230), Color3.fromRGB(225, 245, 255) },
}

local function make(className, properties, parent)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function addCorner(object, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, object)
end

local function addStroke(object, color, transparency, thickness)
    return make("UIStroke", {
        Color = color or COLORS.Border,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
    }, object)
end

local function addPadding(object, left, right, top, bottom)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
    }, object)
end

local function label(parent, text, size, position, fontSize, color, properties)
    local props = {
        BackgroundTransparency = 1,
        Position = position or UDim2.new(),
        Size = size or UDim2.new(1, 0, 0, 20),
        Font = Enum.Font.Gotham,
        Text = text or "",
        TextColor3 = color or COLORS.Text,
        TextSize = fontSize or 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }
    for key, value in pairs(properties or {}) do
        props[key] = value
    end
    return make("TextLabel", props, parent)
end

local function safeCallback(callback, value, control)
    if type(callback) ~= "function" then
        return
    end
    local ok, err = pcall(callback, value, control)
    if not ok then
        warn("[CascadeStyleUI] Callback error: " .. tostring(err))
    end
end

local function setVisibleAnimated(object, visible)
    object.Visible = visible
end

local function bindClick(app, button, callback)
    app:_connect(button.Activated, callback)
end

local function makeVerticalList(parent, padding)
    return make("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, padding or 0),
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
    }, parent)
end

local function setText(button, value)
    if button and button.Parent then
        button.Text = value
    end
end

