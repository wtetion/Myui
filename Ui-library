    local card = makeSettingCard(self, properties.Title or "Toggle", properties.Description and 68 or 54)
    makeDescription(card, properties.Title or "Toggle", properties.Description, 80)

    local button = make("TextButton", {
        Name = "Toggle",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(42, 24),
        BackgroundColor3 = current and COLORS.Green or Color3.fromRGB(205, 206, 212),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, card)
    addCorner(button, 99)
    local knob = make("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = current and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, button)
    addCorner(knob, 99)

    function control:SetValue(value, fire)
        current = value == true
        self.Value = current
        TweenService:Create(button, TweenInfo.new(0.16), {
            BackgroundColor3 = current and COLORS.Green or Color3.fromRGB(205, 206, 212),
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.16), {
            Position = current and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
        }):Play()
        if fire ~= false then
            safeCallback(properties.Callback or properties.Changed, current, self)
        end
    end
    function control:GetValue()
        return current
    end
    bindClick(self._app, button, function()
        control:SetValue(not current, true)
    end)
    return control
end

