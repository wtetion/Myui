function PageSection:Slider(properties)
    properties = properties or {}
    local min = properties.Min or 0
    local max = properties.Max or 100
    local step = properties.Step or 1
    local value = math.clamp(tonumber(properties.Value) or min, min, max)
    local control = { Value = value }
    local card = makeSettingCard(self, properties.Title or "Slider", 76)
    makeDescription(card, properties.Title or "Slider", properties.Description, 112)
    local valueLabel = label(card, tostring(value), UDim2.fromOffset(74, 20), UDim2.new(1, -94, 0, 8), 12, COLORS.Muted, {
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    local track = make("TextButton", {
        Name = "Track",
        Position = UDim2.new(0, 15, 1, -19),
        Size = UDim2.new(1, -30, 0, 5),
        BackgroundColor3 = Color3.fromRGB(221, 222, 227),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, card)
    addCorner(track, 99)
    local fill = make("Frame", {
        Name = "Fill",
        Size = UDim2.new((value - min) / math.max(max - min, 0.0001), 0, 1, 0),
        BackgroundColor3 = COLORS.Blue,
        BorderSizePixel = 0,
    }, track)
    addCorner(fill, 99)
    local handle = make("Frame", {
        Name = "Handle",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((value - min) / math.max(max - min, 0.0001), 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    addCorner(handle, 99)
    addStroke(handle, Color3.fromRGB(204, 205, 210), 0.25, 1)

    function control:SetValue(nextValue, fire)
        value = math.clamp(tonumber(nextValue) or min, min, max)
        if step > 0 then
            value = min + math.floor(((value - min) / step) + 0.5) * step
            value = math.clamp(value, min, max)
        end
        self.Value = value
        local ratio = (value - min) / math.max(max - min, 0.0001)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        handle.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = tostring(value) .. (properties.Suffix or "")
        if fire ~= false then
            safeCallback(properties.Callback or properties.Changed, value, self)
        end
    end
    function control:GetValue()
        return value
    end
    local dragging = false
    local function updateFromInput(input)
        local width = math.max(track.AbsoluteSize.X, 1)
        local ratio = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
        control:SetValue(min + (max - min) * ratio, true)
    end
    self._app:_connect(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end)
    self._app:_connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)
    self._app:_connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    control:SetValue(value, false)
    return control
end

function PageSection:SegmentedControl(properties)
    properties = properties or {}
    local options = properties.Options or { "One", "Two" }
    local value = properties.Value or options[1]
    local control = { Value = value }
    local card = makeSettingCard(self, "SegmentedControl", properties.Preview and 142 or 70)
    label(card, properties.Title or "Choose an option", UDim2.new(1, -30, 0, 20), UDim2.new(0, 15, 0, 11), 13, COLORS.Text, {
        Font = Enum.Font.GothamMedium,
    })
    local row = make("Frame", {
        Name = "Options",
        Position = UDim2.new(0, 13, 0, properties.Preview and 39 or 37),
        Size = UDim2.new(1, -26, 0, properties.Preview and 88 or 25),
        BackgroundTransparency = 1,
    }, card)
    local layout = make("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalFlex = Enum.UIFlexAlignment.Fill,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 7),
    }, row)
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    local optionButtons = {}

    local function refresh()
        for option, button in pairs(optionButtons) do
            local selected = option == value
            button.BackgroundColor3 = selected and Color3.fromRGB(229, 239, 255) or Color3.fromRGB(247, 247, 249)
            local stroke = button:FindFirstChildOfClass("UIStroke")
            if stroke then
                stroke.Color = selected and COLORS.Blue or COLORS.Border
                stroke.Transparency = selected and 0.05 or 0.35
            end
        end
    end
    function control:SetValue(nextValue, fire)
        if table.find(options, nextValue) == nil then
            return
        end
        value = nextValue
        self.Value = value
        refresh()
        if fire ~= false then
            safeCallback(properties.Callback or properties.Changed, value, self)
        end
    end
    function control:GetValue()
        return value
    end

    for index, option in ipairs(options) do
        local button = make("TextButton", {
            Name = "Option_" .. tostring(option),
            Size = UDim2.new(1 / #options, -5, 1, 0),
            BackgroundColor3 = Color3.fromRGB(247, 247, 249),
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = index,
        }, row)
        addCorner(button, 8)
        addStroke(button, COLORS.Border, 0.35, 1)
        if properties.Preview then
            local preview = make("Frame", {
                Position = UDim2.new(0.5, -23, 0, 8),
                Size = UDim2.fromOffset(46, 47),
                BackgroundColor3 = option == "Dark" and Color3.fromRGB(38, 39, 45) or Color3.fromRGB(248, 248, 250),
                BorderSizePixel = 0,
            }, button)
            addCorner(preview, 6)
            addStroke(preview, Color3.fromRGB(191, 192, 198), 0.25, 1)
            make("Frame", {
                Position = UDim2.new(0, 0, 0, 0),
                Size = UDim2.new(0.28, 0, 1, 0),
                BackgroundColor3 = option == "Dark" and Color3.fromRGB(53, 54, 62) or Color3.fromRGB(230, 231, 235),
                BorderSizePixel = 0,
            }, preview)
            label(button, tostring(option), UDim2.new(1, -8, 0, 20), UDim2.new(0, 4, 1, -25), 11, COLORS.Text, {
                TextXAlignment = Enum.TextXAlignment.Center,
                Font = Enum.Font.GothamMedium,
            })
        else
            label(button, tostring(option), UDim2.new(1, -8, 1, 0), UDim2.new(0, 4, 0, 0), 11, COLORS.Text, {
                TextXAlignment = Enum.TextXAlignment.Center,
            })
        end
        optionButtons[option] = button
        bindClick(self._app, button, function()
            control:SetValue(option, true)
        end)
    end
    refresh()
    return control
end

