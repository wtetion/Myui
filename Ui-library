function UI:_connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(self._connections, connection)
    return connection
end

function UI:SetTheme(theme)
    if type(theme) == "table" then
        theme = theme._id or theme.Name
    end
    local wantsDark = theme == "Dark" or theme == "dark" or theme == "AutoDark"
    local light = {
        COLORS.Window,
        COLORS.Sidebar,
        COLORS.Panel,
        COLORS.Text,
        COLORS.Muted,
        COLORS.Border,
        COLORS.Selection,
        Color3.fromRGB(248, 248, 250),
        Color3.fromRGB(116, 117, 123),
        Color3.fromRGB(229, 230, 234),
    }
    local dark = {
        Color3.fromRGB(31, 32, 36),
        Color3.fromRGB(39, 40, 45),
        Color3.fromRGB(49, 50, 56),
        Color3.fromRGB(242, 242, 247),
        Color3.fromRGB(166, 167, 175),
        Color3.fromRGB(75, 76, 83),
        Color3.fromRGB(57, 77, 109),
        Color3.fromRGB(41, 42, 47),
        Color3.fromRGB(166, 167, 175),
        Color3.fromRGB(75, 76, 83),
    }
    if not self.ScreenGui then return end

    local function resolve(color)
        for index, lightColor in ipairs(light) do
            if color == lightColor then
                return wantsDark and dark[index] or lightColor
            elseif color == dark[index] then
                return wantsDark and dark[index] or lightColor
            end
        end
        return color
    end

    for _, object in ipairs(self.ScreenGui:GetDescendants()) do
        if object:IsA("GuiObject") then
            object.BackgroundColor3 = resolve(object.BackgroundColor3)
        end
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            object.TextColor3 = resolve(object.TextColor3)
        elseif object:IsA("UIStroke") then
            object.Color = resolve(object.Color)
        end
    end
    self.Theme = wantsDark and "Dark" or "Light"
end

function UI:SetAccent(accent)
    local previous = self.AccentColor or COLORS.Blue
    local nextAccent = previous
    if typeof(accent) == "Color3" then
        nextAccent = accent
    elseif type(accent) == "table" then
        nextAccent = accent.Color or accent.Light or accent.Dark or previous
    end
    self.Accent = accent
    self.AccentColor = nextAccent
    if not self.ScreenGui then return end
    for _, object in ipairs(self.ScreenGui:GetDescendants()) do
        if object:IsA("GuiObject") and object.BackgroundColor3 == previous then
            object.BackgroundColor3 = nextAccent
        end
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            if object.TextColor3 == previous then object.TextColor3 = nextAccent end
        elseif object:IsA("UIStroke") and object.Color == previous then
            object.Color = nextAccent
        elseif object:IsA("ImageLabel") and object.ImageColor3 == previous then
            object.ImageColor3 = nextAccent
        end
    end
end

function UI:SetSearching(value)
    self.Searching = value == true
    self.SearchBox.Visible = self.Searching
    if self.Searching then
        self.Navigation.Position = UDim2.new(0, 0, 0, 60)
        self.Navigation.Size = UDim2.new(1, 0, 1, -72)
    else
        self.SearchBox.Text = ""
        self.Navigation.Position = UDim2.new(0, 0, 0, 12)
        self.Navigation.Size = UDim2.new(1, 0, 1, -24)
    end
    self:_refreshNavigation(self.SearchBox.Text)
end

function UI:Window(properties)
    properties = properties or {}
    if properties.Title or properties.Subtitle then
        self:SetTitle(properties.Title, properties.Subtitle)
    end
    if properties.Searching ~= nil then
        self:SetSearching(properties.Searching)
    end
    if properties.Draggable ~= nil then
        self.Draggable = properties.Draggable == true
    end
    if properties.Theme ~= nil then
        local selectedTheme = properties.Theme
        if type(selectedTheme) == "table" then selectedTheme = selectedTheme._id or selectedTheme.Name end
        self:SetTheme(selectedTheme)
    end
    if properties.Accent ~= nil then
        self:SetAccent(properties.Accent)
    end
    local context = setmetatable({ _app = self }, WindowContext)
    for key, value in pairs(properties) do
        context[key] = value
    end
    return context
end

function WindowContext:Section(properties)
    return self._app:Section(properties)
end

function WindowContext:SetSearching(value)
    self._app:SetSearching(value)
    self.Searching = value == true
end

function WindowContext:SetDraggable(value)
    self._app.Draggable = value == true
    self.Draggable = self._app.Draggable
end

function WindowContext:SetTheme(theme)
    local selectedTheme = theme
    if type(selectedTheme) == "table" then selectedTheme = selectedTheme._id or selectedTheme.Name end
    self._app:SetTheme(selectedTheme)
    self.Theme = self._app.Theme
end

function WindowContext:SetAccent(accent)
    self._app:SetAccent(accent)
    self.Accent = self._app.Accent
end

function WindowContext:Show()
    self._app:Show()
end

function WindowContext:Hide()
    self._app:Hide()
end

function WindowContext:Notification(properties)
    local body = properties or {}
    local page = self._app.SelectedTab
    if page then
        local section = page:PageSection({ Title = body.Title or "Notification" })
        return section:Notice({ Title = body.Title, Description = body.Subtitle })
    end
    return nil
end

function UI:SetVisible(value)
    if self.ScreenGui and self.ScreenGui.Parent then
        self.ScreenGui.Enabled = value == true
    end
end

function UI:Show()
    self:SetVisible(true)
end

function UI:Hide()
    self:SetVisible(false)
end

function UI:ToggleVisible()
    if self.ScreenGui then
        self:SetVisible(not self.ScreenGui.Enabled)
    end
end

function UI:GoBack()
    if self._historyIndex <= 1 then return end
    self._historyIndex = self._historyIndex - 1
    self._historyNavigation = true
    self:_selectTab(self._history[self._historyIndex])
    self._historyNavigation = false
end

function UI:GoForward()
    if self._historyIndex >= #self._history then return end
    self._historyIndex = self._historyIndex + 1
    self._historyNavigation = true
    self:_selectTab(self._history[self._historyIndex])
    self._historyNavigation = false
end

function UI:SetTitle(title, subtitle)
    self.Title = title or self.Title
    self.WindowTitle.Text = self.Title
    if subtitle ~= nil then
        self.Subtitle = subtitle
    end
    if self.SelectedTab == nil then
        self.PageTitle.Text = self.Title
        self.PageSubtitle.Text = self.Subtitle
    end
end

function UI:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    for _, connection in ipairs(self._connections) do
        connection:Disconnect()
    end
    table.clear(self._connections)
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

function UI:_selectTab(tab)
    if self._destroyed or not tab then
        return
    end
    local ancestor = tab._parent
    while ancestor do
        ancestor:SetExpanded(true)
        ancestor = ancestor._parent
    end
    tab._section:SetExpanded(true)
    if not self._historyNavigation and self.SelectedTab ~= tab then
        for index = #self._history, self._historyIndex + 1, -1 do
            table.remove(self._history, index)
        end
        table.insert(self._history, tab)
        self._historyIndex = #self._history
    end
    self.SelectedTab = tab
    local selectionColor = self.Theme == "Dark" and Color3.fromRGB(57, 77, 109) or COLORS.Selection
    local selectedTextColor = self.Theme == "Dark" and Color3.fromRGB(218, 229, 247) or Color3.fromRGB(28, 77, 139)
    for _, item in ipairs(self.Tabs) do
        local selected = item == tab
        item._page.Visible = selected
        item._row.BackgroundColor3 = selected and selectionColor or Color3.new(1, 1, 1)
        item._row.BackgroundTransparency = selected and 0 or 1
        item._title.TextColor3 = selected and selectedTextColor or (self.Theme == "Dark" and Color3.fromRGB(242, 242, 247) or COLORS.Text)
        item._title.Font = selected and Enum.Font.GothamMedium or Enum.Font.Gotham
    end
    self.PageTitle.Text = tab.Title
    self.PageSubtitle.Text = tab.Subtitle or self.Subtitle
    self:_refreshNavigation(self.SearchBox.Text)
end

local function tabMatches(tab, query)
    if query == "" or string.find(string.lower(tab.Title), query, 1, true) then
        return true
    end
    if tab._page then
        for _, descendant in ipairs(tab._page:GetDescendants()) do
            if descendant.Name == "Row" then
                local searchIndex = descendant:GetAttribute("SearchIndex")
                if searchIndex and string.find(string.lower(searchIndex), query, 1, true) then
                    return true
                end
            end
        end
    end
    for _, child in ipairs(tab._children) do
        if tabMatches(child, query) then
            return true
        end
    end
    return false
end

function UI:_refreshNavigation(rawQuery)
    local query = string.lower(string.gsub(rawQuery or "", "^%s*(.-)%s*$", "%1"))
    local searching = query ~= ""
    for _, tab in ipairs(self.Tabs) do
        if tab._page then
            local tabTitleMatches = not searching or string.find(string.lower(tab.Title), query, 1, true) ~= nil
            for _, descendant in ipairs(tab._page:GetDescendants()) do
                if descendant.Name == "Row" then
                    local searchIndex = descendant:GetAttribute("SearchIndex")
                    if searchIndex and searchIndex ~= "" then
                        descendant.Visible = tabTitleMatches or string.find(string.lower(searchIndex), query, 1, true) ~= nil
                    end
                end
            end
        end
    end
    for _, section in ipairs(self.Sections) do
        local showSection = not searching or string.find(string.lower(section.Title), query, 1, true) ~= nil
        local matchingTab = false
        for _, tab in ipairs(section._tabs) do
            if tabMatches(tab, query) then
                matchingTab = true
                break
            end
        end
        section._frame.Visible = showSection or matchingTab
        for _, tab in ipairs(section._tabs) do
            tab:_refreshVisibility(searching, query, section._expanded or searching)
        end
        section._items.Visible = searching and matchingTab or section._expanded
    end
end

