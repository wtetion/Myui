    return app
end

function UI:_connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(self._connections, connection)
    return connection
end

function UI:SetVisible(value)
    if self.ScreenGui and self.ScreenGui.Parent then
        self.ScreenGui.Enabled = value == true
    end
end

function UI:Show()
    self:SetVisible(true)
end

function UI:Hide()
    self:SetVisible(false)
end

function UI:ToggleVisible()
    if self.ScreenGui then
        self:SetVisible(not self.ScreenGui.Enabled)
    end
end

function UI:SetTitle(title, subtitle)
    self.Title = title or self.Title
    self.WindowTitle.Text = self.Title
    if subtitle ~= nil then
        self.Subtitle = subtitle
    end
    if self.SelectedTab == nil then
        self.PageTitle.Text = self.Title
        self.PageSubtitle.Text = self.Subtitle
    end
end

function UI:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    for _, connection in ipairs(self._connections) do
        connection:Disconnect()
    end
    table.clear(self._connections)
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

function UI:_selectTab(tab)
    if self._destroyed or not tab then
        return
    end
    local ancestor = tab._parent
    while ancestor do
        ancestor:SetExpanded(true)
        ancestor = ancestor._parent
    end
    tab._section:SetExpanded(true)
    self.SelectedTab = tab
    for _, item in ipairs(self.Tabs) do
        local selected = item == tab
        item._page.Visible = selected
        item._row.BackgroundColor3 = selected and COLORS.Selection or Color3.new(1, 1, 1)
        item._row.BackgroundTransparency = selected and 0 or 1
        item._title.TextColor3 = selected and Color3.fromRGB(28, 77, 139) or COLORS.Text
        item._title.Font = selected and Enum.Font.GothamMedium or Enum.Font.Gotham
    end
    self.PageTitle.Text = tab.Title
    self.PageSubtitle.Text = tab.Subtitle or self.Subtitle
    self:_refreshNavigation(self.SearchBox.Text)
end

local function tabMatches(tab, query)
    if query == "" or string.find(string.lower(tab.Title), query, 1, true) then
        return true
    end
    for _, child in ipairs(tab._children) do
        if tabMatches(child, query) then
            return true
        end
    end
    return false
end

function UI:_refreshNavigation(rawQuery)
    local query = string.lower(string.gsub(rawQuery or "", "^%s*(.-)%s*$", "%1"))
    local searching = query ~= ""
    for _, section in ipairs(self.Sections) do
        local showSection = not searching or string.find(string.lower(section.Title), query, 1, true) ~= nil
        local matchingTab = false
        for _, tab in ipairs(section._tabs) do
            if tabMatches(tab, query) then
                matchingTab = true
                break
            end
        end
        section._frame.Visible = showSection or matchingTab
        for _, tab in ipairs(section._tabs) do
            tab:_refreshVisibility(searching, query, section._expanded or searching)
        end
        section._items.Visible = searching and matchingTab or section._expanded
    end
end

function UI:Section(properties)
    properties = properties or {}
    local section = setmetatable({
        _app = self,
        Title = properties.Title or "Section",
        _tabs = {},
        _expanded = properties.Expanded ~= false,
    }, Section)

    local frame = make("Frame", {
        Name = "Section_" .. section.Title,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, self.Navigation)
    makeVerticalList(frame, 3)
    section._frame = frame

    local heading = make("TextButton", {
        Name = "SectionHeading",
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, frame)
    section._heading = heading
    label(heading, section.Title:upper(), UDim2.new(1, -25, 1, 0), UDim2.new(0, 7, 0, 0), 10, Color3.fromRGB(116, 117, 123), {
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    section._arrow = label(heading, section._expanded and "⌄" or "›", UDim2.fromOffset(18, 24), UDim2.new(1, -21, 0, 0), 16, COLORS.Muted, {
        TextXAlignment = Enum.TextXAlignment.Center,
    })

    local items = make("Frame", {
        Name = "SectionItems",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = section._expanded,
    }, frame)
    makeVerticalList(items, 2)
    section._items = items

    bindClick(self, heading, function()
        section:SetExpanded(not section._expanded)
        self:_refreshNavigation(self.SearchBox.Text)
    end)
    table.insert(self.Sections, section)
    self:_refreshNavigation(self.SearchBox.Text)
    return section
end

function Section:SetExpanded(value)
    self._expanded = value == true
    self._items.Visible = self._expanded
    setText(self._arrow, self._expanded and "⌄" or "›")
end

function Section:Tab(properties)
    properties = properties or {}
    local tab = setmetatable({
        _app = self._app,
        _section = self,
        _parent = nil,
        _children = {},
        Title = properties.Title or "Tab",
        Subtitle = properties.Subtitle,
        Icon = properties.Icon or "◈",
        _expanded = properties.Expanded == true,
        _depth = 0,
    }, Tab)
    tab:_build(properties, self._items)
    table.insert(self._tabs, tab)
    if properties.Selected == true or self._app.SelectedTab == nil then
        self._app:_selectTab(tab)
    end
    self._app:_refreshNavigation(self._app.SearchBox.Text)
    return tab
end

function Tab:_build(properties, parent)
    local app = self._app
    app._iconIndex = app._iconIndex + 1
    local palette = ICON_PALETTE[((app._iconIndex - 1) % #ICON_PALETTE) + 1]
    self.IconColor = properties.IconColor or palette[1]
    self.IconBackground = properties.IconBackground or palette[2]

    local node = make("Frame", {
        Name = "TabNode_" .. self.Title,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, parent)
    makeVerticalList(node, 2)
    self._node = node

    local row = make("TextButton", {
        Name = "TabRow",
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ClipsDescendants = true,
    }, node)
    addCorner(row, 8)
    self._row = row

    local indent = 7 + self._depth * 13
    local tileSize = self._depth == 0 and 20 or 16
    local tile = make("Frame", {
        Name = "IconTile",
        Position = UDim2.new(0, indent, 0.5, -tileSize / 2),
        Size = UDim2.fromOffset(tileSize, tileSize),
        BackgroundColor3 = self.IconBackground,
        BorderSizePixel = 0,
    }, row)
    addCorner(tile, self._depth == 0 and 5 or 4)
    if type(self.Icon) == "string" and string.match(self.Icon, "^rbxassetid://") then
        make("ImageLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromScale(0.15, 0.15),
            Size = UDim2.fromScale(0.7, 0.7),
            Image = self.Icon,
            ImageColor3 = self.IconColor,
        }, tile)
    else
        label(tile, self.Icon, UDim2.fromScale(1, 1), UDim2.new(), self._depth == 0 and 13 or 10, self.IconColor, {
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Center,
        })
    end
    self._iconTile = tile

    local title = label(
        row,
        self.Title,
        UDim2.new(1, -(indent + tileSize + 33), 1, 0),
        UDim2.new(0, indent + tileSize + 8, 0, 0),
        12,
        COLORS.Text
    )
    self._title = title

    local arrow = make("TextButton", {
        Name = "Disclosure",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -5, 0.5, 0),
        Size = UDim2.fromOffset(22, 26),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Visible = false,
    }, row)
    label(arrow, self._expanded and "⌄" or "›", UDim2.fromScale(1, 1), UDim2.new(), 16, COLORS.Muted, {
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    self._arrow = arrow:FindFirstChildOfClass("TextLabel")

    local childList = make("Frame", {
        Name = "NestedTabs",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = self._expanded,
    }, node)
    makeVerticalList(childList, 2)
    self._childrenFrame = childList

    self._app:_connect(arrow.Activated, function()
        self:SetExpanded(not self._expanded)
    end)
    self._app:_connect(row.Activated, function()
        app:_selectTab(self)
    end)

    local page = make("ScrollingFrame", {
        Name = "Page_" .. self.Title,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = Color3.fromRGB(174, 176, 183),
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, app.PagesHost)
    addPadding(page, 28, 24, 2, 22)
    local pageList = makeVerticalList(page, 16)
    pageList.HorizontalAlignment = Enum.HorizontalAlignment.Left
    self._page = page
    self.Page = page
    table.insert(app.Tabs, self)
end

function Tab:SetExpanded(value)
    self._expanded = value == true
    self._childrenFrame.Visible = self._expanded
    setText(self._arrow, self._expanded and "⌄" or "›")
    self._arrow.Parent.Visible = #self._children > 0
    self._app:_refreshNavigation(self._app.SearchBox.Text)
end

function Tab:_refreshVisibility(searching, query, ancestorsExpanded)
    local match = tabMatches(self, query)
    self._node.Visible = not searching or match
    if searching then
        self._childrenFrame.Visible = match and #self._children > 0
    else
        self._childrenFrame.Visible = self._expanded
    end
    local showDisclosure = #self._children > 0
    self._arrow.Parent.Visible = showDisclosure
    if searching and showDisclosure then
        self._childrenFrame.Visible = match
    end
    for _, child in ipairs(self._children) do
        child:_refreshVisibility(searching, query, searching or (ancestorsExpanded and self._expanded))
    end
end

function Tab:Tab(properties)
    properties = properties or {}
    local child = setmetatable({
        _app = self._app,
        _section = self._section,
        _parent = self,
        _children = {},
        Title = properties.Title or "Tab",
        Subtitle = properties.Subtitle,
        Icon = properties.Icon or "•",
        _expanded = properties.Expanded == true,
        _depth = self._depth + 1,
    }, Tab)
    child:_build(properties, self._childrenFrame)
    table.insert(self._children, child)
    self._arrow.Parent.Visible = true
    self._app:_refreshNavigation(self._app.SearchBox.Text)
    if properties.Selected == true then
        self._app:_selectTab(child)
    end
    return child
end

function Tab:Select()
    self._app:_selectTab(self)
end

function Tab:PageSection(properties)
    properties = properties or {}
    local section = setmetatable({
        _app = self._app,
        _tab = self,
        Title = properties.Title or "Section",
    }, PageSection)

    local frame = make("Frame", {
        Name = "PageSection_" .. section.Title,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, self._page)
    makeVerticalList(frame, 9)
    section._frame = frame

    label(frame, section.Title, UDim2.new(1, -4, 0, 26), UDim2.new(0, 2, 0, 0), 18, COLORS.Text, {
        Font = Enum.Font.GothamBold,
    })
    if properties.Subtitle then
        label(frame, properties.Subtitle, UDim2.new(1, -4, 0, 0), UDim2.new(0, 2, 0, 0), 12, COLORS.Muted, {
            AutomaticSize = Enum.AutomaticSize.Y,
            TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top,
        })
    end
    return section
end

