function Side:Slider(properties)
    properties = properties or {}
    local minimum = tonumber(properties.Minimum) or 0
    local maximum = tonumber(properties.Maximum) or 100
    if maximum <= minimum then maximum = minimum + 1 end
    local value = math.clamp(tonumber(properties.Value) or minimum, minimum, maximum)
    local app = self._row._app
    rowHeight(self._row, math.max(self._row._frame.Size.Y.Offset, 74))
    local valueText = label(self._container, tostring(value), UDim2.new(1, 0, 0, 17), UDim2.new(0, 0, 0, 9), 11,
        themeColors(app).Muted, { TextXAlignment = Enum.TextXAlignment.Right })
    local track = make("TextButton", {
        Name = "SliderTrack",
        Position = UDim2.new(0, 0, 0, 45),
        Size = UDim2.new(1, 0, 0, 5),
        BackgroundColor3 = Color3.fromRGB(218, 219, 224),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, self._container)
    addCorner(track, 99)
    local ratio = (value - minimum) / (maximum - minimum)
    local fill = make("Frame", { Size = UDim2.new(ratio, 0, 1, 0), BackgroundColor3 = app.AccentColor, BorderSizePixel = 0 }, track)
    addCorner(fill, 99)
    local handle = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(ratio, 0, 0.5, 0),
        Size = UDim2.fromOffset(13, 13),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    addCorner(handle, 99)
    addStroke(handle, Color3.fromRGB(190, 191, 197), 0.1, 1)
    local control = component("Slider", track, value)
    local step = tonumber(properties.Step) or 0
    function control:SetValue(nextValue, fire)
        value = math.clamp(tonumber(nextValue) or minimum, minimum, maximum)
        if step > 0 then
            value = minimum + math.floor((value - minimum) / step + 0.5) * step
            value = math.clamp(value, minimum, maximum)
        end
        self.Value = value
        local nextRatio = (value - minimum) / (maximum - minimum)
        fill.Size = UDim2.new(nextRatio, 0, 1, 0)
        handle.Position = UDim2.new(nextRatio, 0, 0.5, 0)
        valueText.Text = tostring(value)
        if fire ~= false then callback(properties.ValueChanged, self, value) end
    end
    function control:GetValue() return value end
    local dragging = false
    local function update(input)
        local width = math.max(track.AbsoluteSize.X, 1)
        local position = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
        control:SetValue(minimum + (maximum - minimum) * position, true)
    end
    app:_connect(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    app:_connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    app:_connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    return control
end

function Side:RadioButtonGroup(properties)
    properties = properties or {}
    local options = properties.Options or { "Option 1", "Option 2" }
    if #options == 0 then options = { "Option 1" } end
    local selected = tonumber(properties.Value) or 1
    selected = math.clamp(selected, 1, #options)
    local preview = properties.Preview == true
    local app = self._row._app
    local height = preview and 84 or 28
    rowHeight(self._row, math.max(self._row._frame.Size.Y.Offset, preview and 100 or 52))
    self._row._left.Size = UDim2.new(0.46, -16, 1, 0)
    self._row._right.Size = UDim2.new(0.53, 0, 1, 0)
    local holder = make("Frame", {
        Name = "RadioButtonGroup",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 1,
    }, self._container)
    local layout = make("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, preview and 5 or 4),
    }, holder)
    local buttons = {}
    local control = component("RadioButtonGroup", holder, selected)
    local function refresh()
        for index, button in ipairs(buttons) do
            local stroke = button:FindFirstChildOfClass("UIStroke")
            local active = index == selected
            if stroke then
                stroke.Color = active and app.AccentColor or themeColors(app).Border
                stroke.Transparency = active and 0 or 0.35
                stroke.Thickness = active and 1.5 or 1
            end
            button.BackgroundColor3 = active and Color3.fromRGB(239, 245, 255) or themeColors(app).Panel
        end
    end
    function control:SetValue(nextValue, fire)
        local index = tonumber(nextValue)
        if not index and type(nextValue) == "string" then index = table.find(options, nextValue) end
        if not index or index < 1 or index > #options then return end
        selected = math.floor(index)
        self.Value = selected
        refresh()
        if fire ~= false then callback(properties.ValueChanged, self, selected) end
    end
    function control:GetValue() return selected end
    for index, option in ipairs(options) do
        local button = make("TextButton", {
            Name = "Option_" .. tostring(option),
            Size = UDim2.new(1 / #options, preview and -5 or -4, 1, 0),
            BackgroundColor3 = themeColors(app).Panel,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = index,
        }, holder)
        addCorner(button, preview and 8 or 7)
        addStroke(button, themeColors(app).Border, 0.35, 1)
        if preview then
            local previewFrame = make("Frame", {
                Position = UDim2.new(0.5, -18, 0, 5),
                Size = UDim2.new(0, 36, 0, 43),
                BackgroundColor3 = (string.lower(tostring(option)) == "dark") and Color3.fromRGB(39, 40, 46) or Color3.fromRGB(249, 249, 251),
                BorderSizePixel = 0,
            }, button)
            addCorner(previewFrame, 5)
            addStroke(previewFrame, Color3.fromRGB(188, 189, 196), 0.3, 1)
            make("Frame", {
                Position = UDim2.new(0, 0, 0, 0),
                Size = UDim2.new(0.3, 0, 1, 0),
                BackgroundColor3 = (string.lower(tostring(option)) == "dark") and Color3.fromRGB(50, 51, 58) or Color3.fromRGB(230, 231, 235),
                BorderSizePixel = 0,
            }, previewFrame)
            label(button, tostring(option), UDim2.new(1, -4, 0, 17), UDim2.new(0, 2, 1, -20), 10, themeColors(app).Text, {
                TextXAlignment = Enum.TextXAlignment.Center,
                Font = Enum.Font.GothamMedium,
            })
        else
            label(button, tostring(option), UDim2.new(1, -6, 1, 0), UDim2.new(0, 3, 0, 0), 10, themeColors(app).Text, {
                TextXAlignment = Enum.TextXAlignment.Center,
            })
        end
        buttons[index] = button
        bindClick(app, button, function() control:SetValue(index, true) end)
    end
    refresh()
    return control
end

